---
import { Icon } from "astro-icon/components";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import type { WorkEntryView } from "@/utils/works-utils";

interface Props {
	views: WorkEntryView[];
	/** 是否从 1 开始显示序号（正文用）。设置为 false 时用 frontmatter 的 order */
	showIndex?: boolean;
}

const { views, showIndex = true } = Astro.props;
---

<ol class="work-chapter-list">
  {
    views.map((view, i) => (
      <li class="work-chapter-item">
        <a href={view.href} class="work-chapter-link">
          {showIndex && (
            <span class="work-chapter-index">{view.data.order ?? i + 1}</span>
          )}
          <span class="work-chapter-title line-clamp-1">{view.data.title}</span>
          {view.data.published && (
            <span class="work-chapter-date">
              {formatDateToYYYYMMDD(view.data.published)}
            </span>
          )}
          <Icon name="material-symbols:chevron-right-rounded" class="work-arrow" />
        </a>
      </li>
    ))
  }
</ol>
